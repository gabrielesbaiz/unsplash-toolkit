{
    "name": "gabrielesbaiz/unsplash-toolkit",
    "description": "A compliance-first Unsplash toolkit for Laravel: hotlinked images, curated photo pools and correct attribution",
    "keywords": [
        "Gabriele Sbaiz",
        "laravel",
        "unsplash",
        "unsplash-toolkit"
    ],
    "homepage": "https://github.com/gabrielesbaiz/unsplash-toolkit",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriele Sbaiz",
            "email": "gabriele@sbaiz.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/contracts": "^11.0||^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^2.9||^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.11||^2.0"
    },
    "autoload": {
        "psr-4": {
            "Gabrielesbaiz\\UnsplashToolkit\\": "src/",
            "Gabrielesbaiz\\UnsplashToolkit\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gabrielesbaiz\\UnsplashToolkit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gabrielesbaiz\\UnsplashToolkit\\UnsplashToolkitServiceProvider"
            ],
            "aliases": {
                "Unsplash": "Gabrielesbaiz\\UnsplashToolkit\\Facades\\Unsplash"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "laravel/nova": "Required to use the bundled Nova curation action (^4.0|^5.0)"
    }
}
